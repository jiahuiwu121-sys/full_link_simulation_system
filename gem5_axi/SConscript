Import('*')
from SCons.Script import ARGUMENTS

axi_width = int(ARGUMENTS.get('SS_AXI_DATA_WIDTH', '256'))
if axi_width not in (256, 512, 1024):
    raise ValueError('SS_AXI_DATA_WIDTH must be 256, 512 or 1024')
width_compile = {'CPPDEFINES': [('AXI_DATA_WIDTH_CFG', axi_width)]}

env.Append(CPPPATH=[Dir('#/src/systemc/ext')])
SimObject('Gem5Axi.py', sim_objects=['AxiDemo', 'AxiPacketTester', 'MetricsMarker'])
Source('metrics_marker.cc')
Source('axi_master.cc', append=width_compile)
Source('axi_ram.cc', append=width_compile)
Source('axi_demo.cc', append=width_compile)
Source('axi_mux.cc', append=width_compile)
Source('packet_tester.cc')


# Compile protocol sources against gem5's own SystemC implementation.
import os
project_root = os.path.dirname(Dir('.').srcnode().abspath)
env.Append(CPPPATH=[os.path.join(project_root, 'gem5_new/libhettrace/include')])
aou_root = os.path.join(project_root, 'axi2flit/systemc')
ucie_root = os.path.join(project_root, 'ucie-model/src')
env.Append(CPPPATH=[os.path.join(project_root, 'protocol/include'), aou_root + '/include', aou_root + '/integration', ucie_root])
Source('aou_backend.cc', append=width_compile)
Source('aou_axi2flit.cc', append=width_compile)
Source('aou_flit_packer.cc', append=width_compile)
Source('aou_flit_unpacker.cc', append=width_compile)
Source('ramulator_backend.cc', append=width_compile)
env.Append(CPPPATH=[project_root])
ramulator_build = os.path.join(project_root, 'build', 'ramulator2', 'lib')
env.Append(LIBPATH=[ramulator_build], LIBS=['storagestacked_ramulator2'], RPATH=[ramulator_build])
if ARGUMENTS.get('SS_HAVE_MEMSIM', '0') == '1':
    env.Append(CPPDEFINES=['SS_HAVE_MEMSIM'])
    Source('memsim_backend.cc', append=width_compile)
    memsim_root = os.path.join(project_root, 'mem_sim')
    env.Append(CPPPATH=[memsim_root + '/integration'])
    env.Append(LIBPATH=[memsim_root + '/build-unified'], LIBS=['storagestacked_memsim'])
    env.Append(RPATH=[memsim_root + '/build-unified'])
