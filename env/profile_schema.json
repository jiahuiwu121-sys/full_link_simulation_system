{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storagestacked.system.v2",
  "title": "StorageStacked user system profile",
  "type": "object",
  "required": ["schema", "name", "axi", "axi_ports", "ucie_links", "memory_nodes"],
  "properties": {
    "schema": {"const": "storagestacked.system.v2"},
    "name": {"type": "string", "minLength": 1},
    "axi": {
      "type": "object",
      "required": ["data_width_bits", "clock_period"],
      "properties": {
        "data_width_bits": {"enum": [256, 512, 1024]},
        "clock_period": {"type": "string"}
      },
      "additionalProperties": false
    },
    "axi_ports": {"type": "array", "minItems": 1},
    "ucie_links": {"type": "array", "minItems": 1},
    "memory_nodes": {"type": "array", "minItems": 1},
    "sources": {"type": "array"},
    "routing": {"type": "object"},
    "bridge": {
      "type": "object",
      "properties": {
        "resource_planes": {"enum": [1, 2, 3, 4]},
        "tlm_slots": {"type": "integer", "minimum": 1},
        "fabric_clock_ratio": {"enum": [1, 2, 4, 8, 16, 32, 64]}
      }
    },
    "backend": {"type": "object"},
    "requirements": {"type": "object"}
  },
  "additionalProperties": true
}
